<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const shuf=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const same=(a,b)=>a.length===b.length&&a.every(x=>b.includes(x));
const base=JSON.parse($('#bank').textContent);
let Q=[],IMG={},TOPICS=[],imported={q:[],img:{}};
const S={mode:'study',tp:[],tpOpen:false,shuffle:false,list:[],i:0,sel:[],checked:false,expl:false};
const E={phase:'setup',n:20,tp:[],tpOpen:false,qs:[],ans:{},i:0,warn:false,onlyWrong:false};

/* ---- storage (imported questions persist in this browser) ---- */
const DB={open(){return new Promise((res,rej)=>{const r=indexedDB.open('encor-bank',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})},
 async get(k){try{const d=await this.open();return await new Promise(res=>{const q=d.transaction('kv').objectStore('kv').get(k);q.onsuccess=()=>res(q.result);q.onerror=()=>res(null)})}catch(e){return null}},
 async set(k,v){try{const d=await this.open();return await new Promise(res=>{const t=d.transaction('kv','readwrite');t.objectStore('kv').put(v,k);t.oncomplete=()=>res(true);t.onerror=()=>res(false)})}catch(e){return false}}};

/* ---- bank ---- */
function norm(r){let ca=r.correctAnswer;if(typeof ca==='string')ca=ca.split(/[,\s]+/).filter(Boolean);
 return{id:String(r.id),topic:r.topic||'Uncategorized',type:r.type==='lab'?'lab':'mcq',question:r.question||'',options:r.options||{},correctAnswer:ca||[],explanation:r.explanation||'',images:r.images||[],optionImages:r.optionImages||{},noKey:(r.type!=='lab'&&!(ca&&ca.length))}}
function rebuild(){const m=new Map();base.questions.concat(imported.q).forEach(r=>m.set(String(r.id),norm(r)));
 Q=[...m.values()];IMG=Object.assign({},base.images,imported.img);
 TOPICS=base.topics.slice();Q.forEach(q=>{if(!TOPICS.includes(q.topic))TOPICS.push(q.topic)});
 const n=TOPICS.filter(t=>Q.some(q=>q.topic===t)).length;
 $('#stats').textContent=Q.length+' questions in '+n+' topic groups';
 const has=t=>Q.some(q=>q.topic===t);S.tp=S.tp.filter(has);E.tp=E.tp.filter(has);
 pickList()}
const imgSrc=f=>IMG[f]||IMG[String(f).split('/').pop()]||'';
function say(t){$('#toast').innerHTML=t?`<div class="toast">${t}</div>`:''}

/* ---- shared rendering ---- */
function imgTag(f){const s=imgSrc(f);return s?`<img src="${s}" alt="">`:`<div class="mu">[image not loaded: ${esc(f)}]</div>`}
function qBody(q){const multi=q.correctAnswer.length>1;
 return`<div class="meta"><span>${esc(q.id)}</span><span>${esc(q.topic)}</span>${q.type==='lab'?'<span class="tag">Lab</span>':''}${multi?`<span class="tag">Choose ${q.correctAnswer.length}</span>`:''}${q.noKey?'<span class="tag">No answer key</span>':''}</div>
<div class="q">${esc(q.question)}</div>`+q.images.filter(i=>i.role!=='answer').map(i=>imgTag(i.file)).join('')}
function opts(q,sel,checked){const t=q.correctAnswer.length>1?'checkbox':'radio';
 return Object.entries(q.options).map(([k,v])=>{const c=q.correctAnswer.includes(k),s=sel.includes(k);
  let cl='opt';if(checked){if(c)cl+=' ok'+(s?'':' miss');else if(s)cl+=' no'}
  return`<label class="${cl}"><input type="${t}" name="o" data-act="pick" data-k="${k}" ${s?'checked':''} ${checked?'disabled':''}><b>${k}</b><span>${v?esc(v):''}${q.optionImages&&q.optionImages[k]?imgTag(q.optionImages[k]):''}</span></label>`}).join('')}
function explHtml(q){const a=q.images.filter(i=>i.role==='answer');let h=a.map(i=>imgTag(i.file)).join('');
 if(q.explanation)h+=`<div class="ex-t">${esc(q.explanation)}</div>`;
 if(!h)h='<div class="ex-t mu">No explanation provided for this question.</div>';
 return`<div class="expl"><h4>${q.type==='lab'?'Explanation and solution':'Explanation'}</h4>${h}</div>`}

const INFO={"Campus Design & High Availability": "Three-tier and routed-access design, SSO/NSF, StackWise Virtual and VSS, intent-based campus", "Packet Forwarding (RIB, FIB, CEF, TCAM)": "RIB vs FIB, CEF and the adjacency table, process switching, CAM vs TCAM", "QoS": "Classification and marking (DSCP, ToS), policing vs shaping, queuing, policy maps and service policies", "Cloud vs On-Premises": "Cost, scalability, control and latency trade-offs between cloud and on-prem deployments", "Cisco SD-WAN": "vManage, vSmart, vBond and edge routers; OMP, BFD, VPNs, control and data policies", "Cisco SD-Access": "Fabric edge, border and control plane nodes; LISP, VXLAN, ISE, fusion router; fabric wireless", "Hypervisors & Virtual Machines": "Type 1 vs Type 2 hypervisors, VMs, vSwitch, vNIC, OVA/VMDK/VMX files, VM networking", "VRF, GRE & IPsec Tunnels": "VRF and VRF-Lite, route targets, GRE tunnels, MTU and MSS, recursive routing, IPsec over GRE", "LISP & VXLAN": "LISP: ITR, ETR, PITR, map server and resolver, EID and RLOC. VXLAN: VTEP, VNI", "Layer 2 Switching (VLAN, STP, EtherChannel)": "VLANs and trunks, VTP, STP/PVST/MST, root bridge, EtherChannel (LACP, PAgP), BPDU guard", "FHRP (HSRP, VRRP, GLBP)": "HSRP versions, VRRP, GLBP, priority and preemption, virtual IP, multiple groups", "Wireless": "RF basics (SNR, EIRP, antennas), AP modes, WLC, CAPWAP discovery, DHCP option 43, roaming and mobility, Mobility Express", "OSPF": "Network types, neighbor states, DR/BDR, LSA types, area ranges, MTU mismatch, debug output", "EIGRP": "DUAL, feasible successors, unequal-cost load balancing, metrics, EIGRP vs OSPF", "BGP": "eBGP and iBGP peering, path attributes (weight, local preference, AS path, MED), neighbor states, route maps, prepending", "Routing Fundamentals & Path Control": "Routing protocol comparisons, administrative distance, redistribution, PBR, route maps, IPv6 routing", "IP Services (DHCP, NAT, NTP, DNS)": "NAT and PAT, DHCP, NTP and stratum, NTP security, DNS, MTU and fragmentation", "Multicast (PIM, RP)": "PIM sparse and dense mode, rendezvous point (RP), IGMP, multicast forwarding", "Network Assurance & Monitoring": "SNMP, syslog, NetFlow, SPAN and ERSPAN, IP SLA, debug, ping and traceroute, DNA Center Assurance", "Infrastructure Security (ACLs, AAA, Hardening)": "ACLs, AAA (TACACS+, RADIUS), CoPP, device hardening, control-plane protection", "Network Access Security (802.1X, ISE, WLAN Security)": "802.1X, EAP methods (EAP-FAST), ISE, WPA2/WPA3, web authentication, TrustSec", "Automation & Programmability": "REST APIs, NETCONF/RESTCONF, YANG, JSON, Python, Ansible/Puppet/Chef, EEM, DNA Center APIs"};
const examPool=()=>Q.filter(q=>q.type==='mcq'&&!q.noKey&&(!E.tp.length||E.tp.includes(q.topic)));
function topicPicker(o,exam){
 const pool=Q.filter(q=>!exam||q.type==='mcq'),ts=TOPICS.filter(t=>pool.some(q=>q.topic===t));
 const n=o.tp.length?pool.filter(q=>o.tp.includes(q.topic)).length:pool.length;
 const lbl=o.tp.length?o.tp.length+' topic'+(o.tp.length>1?'s':'')+' selected':'All topics';
 let h=`<div class="card tpbox"><button class="tpbtn" data-act="tpopen" aria-expanded="${o.tpOpen}"><span style="color:var(--tx);font-weight:600">Topics: ${lbl} (${n} question${n===1?'':'s'})</span><span>${o.tpOpen?'Hide list':'Choose topics'}</span></button>`;
 if(o.tpOpen)h+=`<div class="btns"><button data-act="tpall">Select all</button><button data-act="tpclr">Clear (use all topics)</button></div><div class="tplist">`+ts.map(t=>{const c=pool.filter(q=>q.topic===t).length;
  return`<label class="tp"><input type="checkbox" data-act="tp" data-t="${esc(t)}" ${o.tp.includes(t)?'checked':''}><span><b>${esc(t)}</b> <i>${c}</i>${INFO[t]?`<small>${esc(INFO[t])}</small>`:''}</span></label>`}).join('')+'</div>';
 return h+'</div>'}

/* ---- study mode ---- */
function pickList(){const l=Q.filter(q=>!S.tp.length||S.tp.includes(q.topic));S.list=S.shuffle?shuf(l):l;S.i=0;S.sel=[];S.checked=false;S.expl=false}
function renderStudy(){const q=S.list[S.i];
 let h=topicPicker(S,false)+`<div class="bar"><label><input type="checkbox" id="shuf" ${S.shuffle?'checked':''}> Shuffle questions</label></div>`;
 if(!q)return h+'<div class="card">No questions in this topic group yet.</div>';
 h+=`<div class="prog">Question ${S.i+1} of ${S.list.length}</div><div class="card">${qBody(q)}`;
 if(q.type==='mcq'){h+=opts(q,S.sel,S.checked);
  if(S.checked){if(q.noKey)h+=`<div class="res">No answer key: the source PDF does not give a clear correct answer for this question. Compare your choice with the explanation.</div>`;else{const ok=same(S.sel,q.correctAnswer);h+=`<div class="res ${ok?'ok':'no'}">${ok?'Correct':'Incorrect. Correct answer: '+q.correctAnswer.join(', ')}</div>`}}}
 h+=`<div class="btns">${q.type==='mcq'?`<button class="pri" data-act="check" ${!S.sel.length||S.checked?'disabled':''}>Check</button>`:''}<button data-act="expl">${S.expl?'Hide':'Show'} explanation</button></div>${S.expl?explHtml(q):''}</div>
<div class="btns"><button data-act="prev" ${S.i?'':'disabled'}>Previous</button><button data-act="next" ${S.i<S.list.length-1?'':'disabled'}>Next</button></div>`;
 return h}

/* ---- exam mode ---- */
function drawExam(n){const by={};examPool().forEach(q=>(by[q.topic]=by[q.topic]||[]).push(q));
 const ts=Object.keys(by),take={};ts.forEach(t=>{take[t]=0;by[t]=shuf(by[t])});
 let left=n;while(left>0){const open=shuf(ts.filter(t=>take[t]<by[t].length));if(!open.length)break;for(const t of open){if(left<=0)break;take[t]++;left--}}
 return shuf(ts.flatMap(t=>by[t].slice(0,take[t])))}
function renderExam(){
 if(E.phase==='setup'){const m=examPool();
  return topicPicker(E,true)+`<div class="card"><h2 style="margin-top:0">Exam mode</h2><p>${m.length} multiple-choice question${m.length===1?' is':'s are'} available in the selected topics. Questions are drawn evenly across those topic groups at random. Lab questions are left out because they can't be scored automatically.</p>
<label>How many questions? <input type="number" id="n" min="1" max="${m.length}" value="${Math.min(E.n,m.length)}"></label>
<div class="btns"><button class="pri" data-act="start" ${m.length?'':'disabled'}>Start exam</button></div></div>`}
 if(E.phase==='run'){const q=E.qs[E.i],done=E.qs.filter(x=>(E.ans[x.id]||[]).length).length,un=E.qs.length-done;
  return`<div class="prog">Question ${E.i+1} of ${E.qs.length}. Answered ${done}.</div>
<div class="pal">${E.qs.map((x,j)=>`<button data-act="go" data-j="${j}" class="${j===E.i?'cur ':''}${(E.ans[x.id]||[]).length?'done':''}" aria-label="Question ${j+1}">${j+1}</button>`).join('')}</div>
<div class="card">${qBody(q)}${opts(q,E.ans[q.id]||[],false)}</div>
<div class="btns"><button data-act="eprev" ${E.i?'':'disabled'}>Previous</button><button data-act="enext" ${E.i<E.qs.length-1?'':'disabled'}>Next</button><button class="pri" data-act="finish">Finish exam</button></div>
${E.warn?`<div class="card" style="margin-top:12px">${un?`You have ${un} unanswered question${un>1?'s':''}. `:''}Submit the exam now?<div class="btns"><button class="pri" data-act="submit">Submit</button><button data-act="cancel">Keep going</button></div></div>`:''}`}
 const res=E.qs.map(q=>({q,ok:same(E.ans[q.id]||[],q.correctAnswer)})),sc=res.filter(r=>r.ok).length,tp={};
 res.forEach(r=>{const t=tp[r.q.topic]=tp[r.q.topic]||[0,0];t[1]++;if(r.ok)t[0]++});
 let h=`<div class="card"><div class="mu">Your score</div><div class="score">${sc} / ${res.length}</div><div style="font-size:20px">${(sc/res.length*100).toFixed(1)}%</div>
<table><tr><th>Topic group</th><th>Correct</th><th>%</th></tr>${Object.entries(tp).map(([t,v])=>`<tr><td>${esc(t)}</td><td>${v[0]} / ${v[1]}</td><td>${(v[0]/v[1]*100).toFixed(0)}%</td></tr>`).join('')}</table>
<div class="btns"><button class="pri" data-act="again">New exam</button><label style="align-self:center"><input type="checkbox" id="wrong" ${E.onlyWrong?'checked':''}> Show only questions I got wrong</label></div></div>`;
 res.forEach((r,j)=>{if(E.onlyWrong&&r.ok)return;const a=E.ans[r.q.id]||[];
  h+=`<div class="card rv ${r.ok?'good':''}"><div class="status ${r.ok?'ok':'no'}">Question ${j+1}: ${r.ok?'Correct':'Incorrect'}</div>${qBody(r.q)}${opts(r.q,a,true)}
<div class="small">Your answer: ${a.length?a.join(', '):'none'}. Correct answer: ${r.q.correctAnswer.join(', ')}.</div>${explHtml(r.q)}</div>`});
 return h}

/* ---- import / export ---- */
const readURL=f=>new Promise(res=>{const r=new FileReader();r.onload=()=>res(r.result);r.readAsDataURL(f)});
async function doImport(files){let nq=[],msg=[];const ni={};
 for(const f of files){if(/\.json$/i.test(f.name)){try{const d=JSON.parse(await f.text()),a=Array.isArray(d)?d:d.questions;if(!Array.isArray(a))throw 0;
   if(d&&d.topics&&!Array.isArray(d))d.topics.forEach(t=>{if(!base.topics.includes(t))base.topics.push(t)});
   a.forEach(r=>{if(r&&r.id&&r.question)nq.push(r)})}catch(e){msg.push(esc(f.name)+' is not a valid question file.')}}
  else if(f.type.startsWith('image/'))ni[f.name]=await readURL(f)}
 const have=new Set(Q.map(q=>q.id));let add=0,upd=0;const seen=new Set();
 nq.forEach(r=>{const id=String(r.id);if(seen.has(id))return;seen.add(id);have.has(id)?upd++:add++});
 const mq=new Map(imported.q.map(r=>[String(r.id),r]));nq.forEach(r=>mq.set(String(r.id),r));
 imported={q:[...mq.values()],img:Object.assign(imported.img,ni)};
 await DB.set('imported',imported);rebuild();
 const miss=nq.reduce((n,r)=>n+(r.images||[]).filter(i=>!imgSrc(i.file)).length,0);
 say(`Imported: ${add} added, ${upd} updated.`+(miss?` ${miss} image reference(s) have no matching image file. Import the images together with the JSON.`:'')+' '+msg.join(' '));render()}
function download(name,text){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type:'application/json'}));a.download=name;a.click()}

/* ---- events ---- */
function act(a,b){say('');
 if(a==='mode'){S.mode=b.dataset.m}
 else if(a==='pick'){const k=b.dataset.k,multi=(S.mode==='study'?S.list[S.i]:E.qs[E.i]).correctAnswer.length>1;
  if(S.mode==='study'){if(S.checked)return;S.sel=multi?(S.sel.includes(k)?S.sel.filter(x=>x!==k):S.sel.concat(k)):[k]}
  else{const id=E.qs[E.i].id,c=E.ans[id]||[];E.ans[id]=multi?(c.includes(k)?c.filter(x=>x!==k):c.concat(k)):[k];E.warn=false}}
 else if(a==='check')S.checked=true;
 else if(a==='expl')S.expl=!S.expl;
 else if(a==='prev'||a==='next'){S.i+=a==='next'?1:-1;S.sel=[];S.checked=false;S.expl=false}
 else if(a==='start'){const m=examPool().length,n=Math.max(1,Math.min(m,parseInt($('#n').value)||1));E.n=n;E.qs=drawExam(n);E.ans={};E.i=0;E.warn=false;E.onlyWrong=false;E.phase='run'}
 else if(a==='go'){E.i=+b.dataset.j}
 else if(a==='eprev')E.i--;else if(a==='enext')E.i++;
 else if(a==='finish')E.warn=true;else if(a==='cancel')E.warn=false;
 else if(a==='submit'){E.phase='result';E.warn=false}
 else if(a==='again'){E.phase='setup'}
 else if(a==='tp'||a==='tpall'||a==='tpclr'||a==='tpopen'){const o=S.mode==='study'?S:E;
  if(a==='tp'){const t=b.dataset.t;o.tp=o.tp.includes(t)?o.tp.filter(x=>x!==t):o.tp.concat(t)}
  else if(a==='tpall')o.tp=TOPICS.filter(t=>Q.some(q=>q.topic===t&&(o===S||q.type==='mcq')));
  else if(a==='tpclr')o.tp=[];
  else o.tpOpen=!o.tpOpen;
  if(o===S&&a!=='tpopen')pickList()}
 else if(a==='imp'){$('#file').click();return}
 else if(a==='exp'){download('question_bank.json',JSON.stringify(Q,null,2));say('Exported all questions as question_bank.json (images are not included in the export).');return}
 else if(a==='clr'){imported={q:[],img:{}};DB.set('imported',imported).then(()=>{rebuild();say('Cleared imported questions. The built-in questions are unchanged.');render()});return}
 if(['submit','start','prev','next','again','eprev','enext','go'].includes(a))scrollTo(0,0);render()}
document.addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(b)act(b.dataset.act,b)});
document.addEventListener('change',e=>{
 if(e.target.id==='shuf'){S.shuffle=e.target.checked;pickList();render()}
 else if(e.target.id==='n'){E.n=parseInt(e.target.value)||1}
 else if(e.target.id==='wrong'){E.onlyWrong=e.target.checked;render()}
 else if(e.target.id==='file'){doImport([...e.target.files]);e.target.value=''}});
function render(){document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.m===S.mode));
 $('#app').innerHTML=S.mode==='study'?renderStudy():renderExam()}
(async()=>{const s=await DB.get('imported');if(s&&s.q)imported=s;rebuild();render()})();
</script></body></html>
