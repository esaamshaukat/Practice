<style>
:root{--bg:#eef1f4;--card:#fff;--tx:#17222d;--mu:#5d6b79;--bd:#d3dae1;--ac:#0e7c86;--acbg:#e0f2f3;--ok:#1a7f45;--okbg:#dcf3e4;--no:#c2362b;--nobg:#fbe3e0}
@media(prefers-color-scheme:dark){:root{--bg:#10161c;--card:#19212a;--tx:#e6ebf0;--mu:#95a3b1;--bd:#2d3945;--ac:#4fc3cc;--acbg:#12313a;--ok:#5fd18a;--okbg:#13301f;--no:#ff8a7d;--nobg:#3a1a17}}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 "Segoe UI",system-ui,-apple-system,sans-serif}
.wrap{max-width:820px;margin:0 auto;padding:12px 14px 60px}
header{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;justify-content:space-between;padding:10px 0 14px}
h1{font-size:19px;margin:0;font-weight:650}h1 small{display:block;font-weight:400;color:var(--mu);font-size:13px}
.tabs{display:flex;gap:4px;background:var(--card);border:1px solid var(--bd);border-radius:9px;padding:3px}
.tabs button{border:0;background:none;color:var(--tx);padding:7px 16px;border-radius:7px;font:inherit;cursor:pointer}
.tabs button.on{background:var(--ac);color:#fff}
.tools{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
button,select,input[type=number]{font:inherit;color:var(--tx)}
.tools button,.btns button,.bar select{background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:7px 13px;cursor:pointer}
.tools button{font-size:13px;padding:5px 10px}
button:hover:not(:disabled){border-color:var(--ac)}button:disabled{opacity:.45;cursor:default}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
.btns button.pri{background:var(--ac);border-color:var(--ac);color:#fff}
.toast{background:var(--acbg);border:1px solid var(--ac);border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:14px}
.bar{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:10px}.bar select{max-width:100%}
.prog{color:var(--mu);font-size:14px;margin:4px 0 8px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:16px 18px;margin-bottom:12px}
.meta{display:flex;flex-wrap:wrap;gap:6px 12px;color:var(--mu);font-size:13px;margin-bottom:8px}
.tag{background:var(--acbg);color:var(--ac);border-radius:5px;padding:0 7px;font-weight:600}
.q{white-space:pre-wrap;font-size:17px;margin-bottom:12px}
.card img{max-width:100%;height:auto;display:block;margin:8px 0 12px;border:1px solid var(--bd);border-radius:6px;background:#fff}
.opt{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--bd);border-radius:8px;padding:9px 12px;margin:7px 0;cursor:pointer}
.opt:hover{border-color:var(--ac)}.opt input{margin-top:5px}.opt b{min-width:1.3em;color:var(--mu)}.opt span{flex:1}
.opt.ok{background:var(--okbg);border-color:var(--ok)}.opt.no{background:var(--nobg);border-color:var(--no)}
.opt.ok.miss{border-style:dashed}
.res{margin:10px 0;padding:8px 12px;border-radius:8px;font-weight:600}.res.ok{background:var(--okbg);color:var(--ok)}.res.no{background:var(--nobg);color:var(--no)}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.expl{margin-top:14px;border-top:1px solid var(--bd);padding-top:10px}.expl h4{margin:0 0 6px;font-size:15px}.ex-t{white-space:pre-wrap}
.tpbox{padding:12px 14px}
.tpbtn{width:100%;display:flex;justify-content:space-between;gap:10px;text-align:left;background:none;border:0;padding:0;font:inherit;cursor:pointer;color:var(--tx);font-weight:600}.tpbtn span{color:var(--ac);font-weight:400;white-space:nowrap}
.tplist{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:6px 14px;margin-top:10px}
.tp{display:flex;gap:9px;align-items:flex-start;padding:7px 9px;border:1px solid var(--bd);border-radius:8px;cursor:pointer}.tp:hover{border-color:var(--ac)}.tp input{margin-top:5px}
.tp i{color:var(--mu);font-style:normal;font-size:13px}.tp small{display:block;color:var(--mu);font-size:12.5px;line-height:1.35;margin-top:2px}
.mu{color:var(--mu)}.small{font-size:13px;margin-top:12px}
.pal{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.pal button{width:36px;height:32px;border:1px solid var(--bd);background:var(--card);border-radius:6px;cursor:pointer;font-size:13px}
.pal button.done{background:var(--acbg);border-color:var(--ac)}.pal button.cur{outline:2px solid var(--ac)}
.score{font-size:34px;font-weight:700;margin:2px 0}
table{border-collapse:collapse;width:100%;font-size:14px;margin-top:8px}td,th{text-align:left;padding:5px 8px;border-bottom:1px solid var(--bd)}
.rv{border-left:5px solid var(--no)}.rv.good{border-left-color:var(--ok)}
.status{font-weight:700}.status.ok{color:var(--ok)}.status.no{color:var(--no)}
input[type=number]{width:90px;padding:6px 8px;border:1px solid var(--bd);border-radius:8px;background:var(--card)}
@media(max-width:520px){.card{padding:13px}.q{font-size:16px}}
